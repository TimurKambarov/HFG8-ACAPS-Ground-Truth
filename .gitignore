# Flutter/Dart build output inside app/ is ignored by app/.gitignore.

# Secrets: never commit keys or the Android signing keystore
API.key
*.key
*.pem
.env
.env.*
key.properties
*.jks
*.keystore

# Editors and AI tools (the shared VS Code launch configurations are kept)
.idea/
.claude/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Scripts
.dart_tool/
__pycache__/

# Removed folders: only local build leftovers remain on some machines
/app-mobile/
/auth-lab/
