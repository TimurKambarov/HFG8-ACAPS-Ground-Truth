{
  // Run and Debug configurations for the two Flutter apps.
  // The target device is whatever is selected in the VS Code status bar
  // (e.g. your phone over wireless debugging, or Edge for the web).
  "version": "0.2.0",
  "configurations": [
    {
      // Real accounts and ACAPS's risks: the task passes only SUPABASE_URL and
      // SUPABASE_PUBLISHABLE_KEY from ../API.key (never the secret key).
      "name": "app-mobile (phone)",
      "cwd": "app-mobile",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "preLaunchTask": "Supabase keys (app-mobile)",
      "toolArgs": ["--dart-define-from-file=.dart_tool/supabase_keys.json"]
    },
    {
      "name": "app (reference)",
      "cwd": "app",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug"
    },
    {
      "name": "app (Edge)",
      "cwd": "app",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "deviceId": "edge",
      // Moderator → Risks → Import needs the ACAPS API proxy in the browser.
      "preLaunchTask": "ACAPS API proxy"
    },
    {
      "name": "app-mobile (Edge)",
      "cwd": "app-mobile",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "deviceId": "edge",
      "preLaunchTask": "Supabase keys (app-mobile)",
      "toolArgs": ["--dart-define-from-file=.dart_tool/supabase_keys.json"]
    }
  ]
}
